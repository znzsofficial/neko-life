{
  "schema_version": 2,
  "required_capabilities": ["declarative_basic"],
  "workspace_title": "Neko Life",
  "pages": [{
    "id": "overview",
    "title": "探索与生活",
    "placement": "workspace",
    "icon": "list",
    "poll_interval_seconds": 30,
    "queries": {"status": {"api": "status_v1", "version": "1"}},
    "content": [
      {"type": "text", "label": "运行状态", "value": {"source": "status", "field": "state_label"}},
      {"type": "text", "label": "最近错误（未发生则无）", "value": {"source": "status", "field": "error_label"}},
      {"type": "text", "label": "最近跳过原因", "value": {"source": "status", "field": "skip_label"}},
      {"type": "text", "label": "预算说明", "value": {"source": "status", "field": "budget_label"}},
      {"type": "text", "label": "当前角色活动（非现实证据）", "value": {"source": "status", "field": "activity_label"}},
      {"type": "table", "label": "角色日程", "value": {"source": "status", "field": "schedule_rows"}, "columns": [
        {"field": "start", "label": "开始"}, {"field": "end", "label": "结束"},
        {"field": "summary", "label": "角色安排"}, {"field": "source", "label": "来源"}
      ]},
      {"type": "table", "label": "最近探索（含未探索和失败）", "value": {"source": "status", "field": "job_rows"}, "columns": [
        {"field": "at", "label": "时间"}, {"field": "status", "label": "状态"},
        {"field": "topic", "label": "主题"}, {"field": "query", "label": "实际查询"},
        {"field": "reason", "label": "说明"}
      ]},
      {"type": "table", "label": "公开见闻与来源", "value": {"source": "status", "field": "note_rows"}, "columns": [
        {"field": "topic", "label": "主题"}, {"field": "summary", "label": "资料摘要"},
        {"field": "opinion", "label": "个人看法"}, {"field": "sources", "label": "来源与阅读范围"}
      ]},
      {"type": "table", "label": "今日用量（预留含未知，非精确金额）", "value": {"source": "status", "field": "usage"}, "columns": [
        {"field": "kind", "label": "类型"}, {"field": "calls", "label": "次数"},
        {"field": "input_reserved", "label": "输入已记账/预留"}, {"field": "output_reserved", "label": "输出已记账/预留"}
      ]},
      {"type": "text", "label": "暂停与管理", "value": {"source": "status", "field": "manage_label"}}
    ]
  }]
}
