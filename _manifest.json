{
  "manifest_version": 2,
  "id": "neko.life",
  "name": "Neko Life",
  "version": "0.4.0",
  "description": "有预算的公开资料探索、生活日程与有界背景，默认关闭。",
  "author": {"name": "NekoLaska", "url": "https://github.com/znzsofficial"},
  "urls": {"repository": "https://github.com/znzsofficial/neko-life", "homepage": "https://github.com/znzsofficial/neko-life", "issues": "https://github.com/znzsofficial/neko-life/issues"},
  "license": "MIT",
  "host_application": {"min_version": "1.3.9", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.12.0", "max_version": "2.99.99"},
  "dependencies": [{"type":"python_package", "name":"tzdata", "version_spec":">=2025.2"}],
  "capabilities": ["api.call", "config.get", "llm.generate"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
